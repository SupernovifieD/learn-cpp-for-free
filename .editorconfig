# Keeps every contributor's editor consistent: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Two spaces is the YAML convention (workflows)
[*.{yml,yaml}]
indent_size = 2

# Trailing spaces can be meaningful in Markdown (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles require tab indentation
[Makefile]
indent_style = tab
